using Gtk 4.0;
using Adw 1;

Adw.Dialog dialog {
  title: _("Split Focus");
  content-width: 600;
  content-height: 500;
  closed => $closed();

  Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      title-widget: Gtk.SearchEntry search {
        placeholder-text: _("Search windows, tabs and splits");
        search-changed => $search_changed();
        activate => $search_activated();
        stop-search => $search_stopped();
      };

      [end]
      Gtk.CheckButton hide_unmatched {
        label: _("Hide non-matching");
        toggled => $hide_unmatched_toggled();
      }
    }

    Gtk.ScrolledWindow {
      vexpand: true;
      hscrollbar-policy: never;

      Gtk.ListView view {
        single-click-activate: true;
        activate => $row_activated();

        model: Gtk.SingleSelection model {
          // Not incremental: the dialog reads this model synchronously
          // right after invalidating it -- to preselect the current split
          // on open, and to check the selection survived each keystroke.
          // Incremental filtering does nothing until an idle callback
          // runs, so those reads would all see an empty model. The tree is
          // tens of rows; incremental only pays off in the tens of
          // thousands.
          model: Gtk.FilterListModel filter_model {};
        };
      }
    }
  }
}
